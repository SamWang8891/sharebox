# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated emails that get admin access
ADMIN_EMAILS=admin@example.com

# Stack Auth (Neon Auth) — get these from Neon dashboard → Auth tab
STACK_PROJECT_ID=your-stack-project-id
STACK_PUBLISHABLE_CLIENT_KEY=your-publishable-client-key
STACK_SECRET_SERVER_KEY=your-secret-server-key

# Frontend needs the public Stack keys (Vite env vars, embedded in the bundle)
VITE_STACK_PROJECT_ID=your-stack-project-id
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your-publishable-client-key

# Max upload size in bytes (default 80MB)
MAX_UPLOAD_SIZE=83886080
