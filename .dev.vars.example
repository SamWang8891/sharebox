# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated emails that get admin access
ADMIN_EMAILS=admin@example.com

# Clerk (auth) — get from https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Frontend needs the publishable key as a Vite build-time var (same value)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Limits — leave blank to disable. Cloudflare Workers free-tier request body
# cap is 100 MB, so keep MAX_UPLOAD_SIZE ≤ ~95 MB.
MAX_UPLOAD_SIZE=94371840              # 90 MB per file
MAX_TOTAL_STORAGE_BYTES=10737418240   # 10 GB total (R2 free tier)
MAX_TOTAL_DOWNLOADS=10000000          # 10M downloads/month (R2 Class B free tier)
MAX_TOTAL_BANDWIDTH_BYTES=            # blank = unlimited (R2 egress is free)

# Optional: Collabora Online for in-browser document editing.
# When unset, the Edit feature is hidden everywhere.
# COLLABORA_URL=https://ncoffice.smashit.tw
